DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SAMESITE=Lax

CACHE_URL=redis://:replace-with-the-same-url-safe-local-password@127.0.0.1:6379/0
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

DB_ENGINE=sqlite
SQLITE_DB_NAME=dev.sqlite3
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-your-supabase-database-password
DB_HOST=your-project-ref.supabase.co
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
